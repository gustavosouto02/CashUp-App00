    "Revise extratos de cartões a cada trimestre. Serviços de streaming e assinaturas esquecidas acumulam valores expressivos ao longo de 1 ano." : {
      "comment" : "Chave dinâmica: corpo de dica de tips.json (BundledTipsRepository)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review your bank and card statements quarterly. Unused streaming services and forgotten memberships add up to serious cash over a year."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa los extractos de tus tarjetas cada trimestre. Los servicios de streaming y las suscripciones olvidadas acumulan montos importantes a lo largo de 1 año."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise extratos de cartões a cada trimestre. Serviços de streaming e assinaturas esquecidas acumulam valores expressivos ao longo de 1 ano."
          }
        }
      }
    },
