    "%lld%% do seu dinheiro foi gasto no sábado e domingo. Dá uma segurada no combo delivery, passeios e saidinhas para não desbalancear a semana!" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld%% of your money was spent on Saturday and Sunday. Ease up on takeout, outings, and treats to keep your week balanced!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld%% de tu dinero se gastó el sábado y domingo. ¡Modera los pedidos a domicilio y salidas para no desbalancear la semana!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld%% do seu dinheiro foi gasto no sábado e domingo. Dá uma segurada no combo delivery, passeios e saidinhas para não desbalancear a semana!"
          }
        }
      }
    },
